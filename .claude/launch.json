{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "invite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "invite-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "invite-pages",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "3002", "--directory", "tmp/pages-site"],
      "port": 3002
    }
  ]
}
